#!/bin/bash

set -e  # Exit on error

echo "=========================================="
echo "Starting Protocol Buffer Code Generation"
echo "=========================================="

# Colors for output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

# Function to print colored output
print_status() {
    echo -e "${GREEN}[INFO]${NC} $1"
}

print_warning() {
    echo -e "${YELLOW}[WARN]${NC} $1"
}

print_error() {
    echo -e "${RED}[ERROR]${NC} $1"
}

# Ensure Go bin directory is in PATH
export PATH=$PATH:$(go env GOPATH)/bin

# Update package list (optional, but recommended)
print_status "Updating package list..."
sudo apt update -qq

# 1. Install Python dependencies (Ubuntu)
print_status "Installing Python dependencies..."
if ! command -v pip3 &> /dev/null; then
    print_warning "pip3 not found, installing..."
    sudo apt install -y python3-pip
fi

# Install grpcio-tools
if ! python3 -c "import grpc_tools" 2>/dev/null; then
    print_warning "grpcio-tools not found, installing..."
    pip3 install grpcio-tools
    print_status "grpcio-tools installed successfully"
else
    print_status "grpcio-tools already installed"
fi

# 2. Install protoc (Ubuntu)
print_status "Installing protoc..."
if ! command -v protoc &> /dev/null; then
    print_warning "protoc not found, installing..."
    
    # Install from apt (preferred for Ubuntu)
    if sudo apt install -y protobuf-compiler; then
        print_status "protoc installed from apt: $(protoc --version)"
    else
        # Fallback: Download from GitHub if apt fails
        print_warning "Apt installation failed, downloading from GitHub..."
        
        PROTOC_VERSION="25.1"
        PLATFORM="linux"
        ARCH_TYPE="x86_64"
        
        # Check architecture
        if [ "$(uname -m)" = "aarch64" ]; then
            ARCH_TYPE="aarch_64"
        fi
        
        TEMP_DIR=$(mktemp -d)
        cd "${TEMP_DIR}"
        
        curl -LO "https://github.com/protocolbuffers/protobuf/releases/download/v${PROTOC_VERSION}/protoc-${PROTOC_VERSION}-${PLATFORM}-${ARCH_TYPE}.zip"
        unzip "protoc-${PROTOC_VERSION}-${PLATFORM}-${ARCH_TYPE}.zip"
        sudo mv bin/protoc /usr/local/bin/
        sudo mv include/* /usr/local/include/
        
        cd - > /dev/null
        rm -rf "${TEMP_DIR}"
        
        print_status "protoc installed from GitHub: $(protoc --version)"
    fi
else
    print_status "protoc already installed: $(protoc --version)"
fi

# 3. Install Go plugins (Ubuntu)
print_status "Installing Go plugins..."

# Install protoc-gen-go
if ! command -v protoc-gen-go &> /dev/null; then
    print_warning "protoc-gen-go not found, installing..."
    go install google.golang.org/protobuf/cmd/protoc-gen-go@latest
    print_status "protoc-gen-go installed"
else
    print_status "protoc-gen-go already installed"
fi

# Install protoc-gen-go-grpc
if ! command -v protoc-gen-go-grpc &> /dev/null; then
    print_warning "protoc-gen-go-grpc not found, installing..."
    go install google.golang.org/grpc/cmd/protoc-gen-go-grpc@latest
    print_status "protoc-gen-go-grpc installed"
else
    print_status "protoc-gen-go-grpc already installed"
fi

# 4. Install make if not present
print_status "Checking make..."
if ! command -v make &> /dev/null; then
    print_warning "make not found, installing..."
    sudo apt install -y make
    print_status "make installed"
else
    print_status "make already installed"
fi

# 5. Create output directories
print_status "Creating output directories..."
mkdir -p proto
mkdir -p python/cyberpb2

# 6. Run code generation
print_status "Running code generation..."

# Check if proto file exists
if [ ! -f "proto/cyber.proto" ]; then
    print_error "proto/cyber.proto not found!"
    exit 1
fi

# Try using Makefile first
if [ -f "Makefile" ]; then
    print_status "Using Makefile..."
    echo "----------------------------------------"
    echo "Executing: make gen"
    echo "----------------------------------------"
    
    if make gen; then
        print_status "✅ Generation completed successfully!"
    else
        print_error "❌ Make generation failed. Trying direct commands..."
        
        # Fallback to direct commands
        print_status "Generating Go code..."
        protoc -I ./proto \
            --go_out ./proto \
            --go_opt paths=source_relative \
            --go-grpc_out ./proto \
            --go-grpc_opt paths=source_relative \
            ./proto/cyber.proto
        
        print_status "Generating Python code..."
        python3 -m grpc_tools.protoc -I ./proto \
            --python_out ./python/cyberpb2 \
            --grpc_python_out ./python/cyberpb2 \
            ./proto/cyber.proto
        
        print_status "✅ Generation completed successfully!"
    fi
else
    # No Makefile, run commands directly
    print_warning "Makefile not found, running commands directly..."
    
    print_status "Generating Go code..."
    protoc -I ./proto \
        --go_out ./proto \
        --go_opt paths=source_relative \
        --go-grpc_out ./proto \
        --go-grpc_opt paths=source_relative \
        ./proto/cyber.proto
    
    print_status "Generating Python code..."
    python3 -m grpc_tools.protoc -I ./proto \
        --python_out ./python/cyberpb2 \
        --grpc_python_out ./python/cyberpb2 \
        ./proto/cyber.proto
    
    print_status "✅ Generation completed successfully!"
fi

# 7. Add __init__.py files for Python packages
print_status "Adding Python package files..."
touch python/__init__.py
touch python/cyberpb2/__init__.py

# 8. Fix Python imports (optional - for gRPC compatibility)
print_status "Fixing Python imports..."
if [ -f "python/cyberpb2/cyber_pb2_grpc.py" ]; then
    # On some systems, you might need to fix imports
    # This replaces 'import cyber_pb2' with 'from . import cyber_pb2'
    sed -i 's/^import cyber_pb2/from . import cyber_pb2/' python/cyberpb2/cyber_pb2_grpc.py 2>/dev/null || true
    sed -i 's/^import cyber_pb2/from . import cyber_pb2/' python/cyberpb2/cyber_pb2.py 2>/dev/null || true
fi

# 9. Summary
echo "=========================================="
print_status "✅ Generation complete!"
echo "=========================================="

# Show generated files
echo ""
echo "📁 Generated Go files (./proto):"
ls -la proto/*.pb.go 2>/dev/null || echo "  No .pb.go files found"

echo ""
echo "📁 Generated Python files (./python/cyberpb2):"
ls -la python/cyberpb2/*.py 2>/dev/null || echo "  No Python files found"

# Show versions
echo ""
echo "📦 Versions:"
echo "  protoc: $(protoc --version 2>/dev/null || echo 'Not found')"
echo "  Go: $(go version 2>/dev/null || echo 'Not found')"
echo "  Python: $(python3 --version 2>/dev/null || echo 'Not found')"

echo ""
print_status "Done!"